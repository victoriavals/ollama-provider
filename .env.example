# Copy to .env and adjust. All values shown are the defaults unless noted.

# --- Upstream Ollama (loopback only) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
UPSTREAM_CONNECT_TIMEOUT=5
UPSTREAM_READ_TIMEOUT=300

# --- Listeners ---
# Public port is the only one Cloudflare Tunnel routes to. Admin port stays local.
BIND_HOST=127.0.0.1
PUBLIC_PORT=8000
ADMIN_PORT=8001
# REQUIRED for the admin API. Generate with: python -m gateway.cli gen-admin-key
ADMIN_KEY=
LIMIT_CONCURRENCY=64
# Headers carrying the real client IP, checked in order (Cloudflare first, then
# Tailscale Funnel / ngrok). For X-Forwarded-For the last entry is used.
CLIENT_IP_HEADERS=cf-connecting-ip,x-forwarded-for

# --- Storage ---
DB_PATH=data/gateway.db
USAGE_RETENTION_DAYS=90
# Comma-separated; added to the allowlist on first start
SEED_MODELS=gemma3:4b

# --- Per-key defaults (override per key via admin API / CLI) ---
DEFAULT_RPM=60
DEFAULT_MAX_CONCURRENT=2

# --- GPU capacity: keep GLOBAL_CONCURRENCY equal to OLLAMA_NUM_PARALLEL ---
GLOBAL_CONCURRENCY=4
QUEUE_TIMEOUT_S=20
STREAM_PING_INTERVAL_S=15

# --- Request limits ---
# Non-streaming requests must finish within Cloudflare's 100 s limit; keep this modest.
MAX_TOKENS_CAP=2048
MAX_BODY_BYTES=4000000
MAX_MESSAGES=100
MAX_IMAGES=2
MAX_EMBEDDING_INPUTS=256
FAILED_AUTH_PER_IP_PER_MIN=20

WARMUP=true

# --- Logging (daily files: gateway-, access-, health-YYYY-MM-DD.log) ---
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_RETENTION_DAYS=30
# The Windows service sets LOG_CONSOLE=false (files only)
LOG_CONSOLE=true

# --- Dependency health monitor ---
HEALTH_INTERVAL_S=30
HEALTH_SNAPSHOT_INTERVAL_S=300
WATCH_SERVICES=OllamaServe,Cloudflared
# Comma-separated paths whose drives are checked for free space (empty = DB drive + system drive)
MONITOR_PATHS=
DISK_WARN_GB=10
GPU_TEMP_WARN_C=85
